  "version": "m2-v0.2",
  "baseVersion": "m1-v1.1",
  "note": "8 boards. tuning/strings/rules shared by all boards, copied verbatim from m1-v1.1; a board may override ONLY laneQuota = preset lane cells (forks excluded) + one full column (grid.rows). Each board has the same shape as data/m1-config.json in next-build bcf91cf (grid, presetLanes, forks, sources, exit, waves).",
  "tuning": {
    "tickSec": 0.25,
    "cellsPerSec": 2,
    "digSecPerCell": 0.4,
    "fillSecPerCell": 0.4,
    "digQueueMax": 4,
    "laneQuota": 18,
    "minGapCells": 1,
    "widePreviewSec": 5,
    "sourceQueueMax": 3,
    "cargoTimeoutSec": 20,
    "timeoutsToFail": 3,
    "jamShakeAfterSec": 1.0,
    "jamShakeCooldownSec": 2.0,
    "spawnStopSec": 75,
    "clearGraceSec": 15,
    "erodeIdleSec": 6,
    "erodeWarnSec": 2,
    "wideJitterSec": 2,
    "firstWideGraceSec": 0,
    "wideJitterStepSec": 0.5
  },
  "strings": {
    "win": {
      "zh": "让开了",
      "en": "Way made"
    },
    "failJam": {
      "zh": "{gate} 口堵死了",
      "en": "Gate {gate} backed up"
    },
    "failTime": {
      "zh": "三托货没等到",
      "en": "Three loads gave up"
    },
    "quota": {
      "zh": "巷 {used}/{max}",
      "en": "Lanes {used}/{max}"
    },
    "failClear": {
      "zh": "收尾没清完",
      "en": "Lanes not cleared"
    },
    "failJamWide": {
      "zh": "{gate} 口被宽货堵住了",
      "en": "Gate {gate} jammed by a wide load"
    },
    "failJamWideHint": {
      "zh": "宽货要一整条两格宽的道，从上通到底",
      "en": "Wide loads need a 2-wide lane all the way down"
    },
    "failJamHint": {
      "zh": "货进不来了：腾出路，或换一条走",
      "en": "Cargo can't get in: clear a path"
    },
    "failStuckWide": {
      "zh": "宽货卡住，挡住了 {gate} 口",
      "en": "Wide load stuck, blocking Gate {gate}"
    },
    "failStuckWideHint": {
      "zh": "先把宽货下面的路挖通到底",
      "en": "Dig its lane through to the bottom first"
    },
    "collapse": {
      "zh": "没人走，塌了",
      "en": "Unused, collapsed"
    },
    "hardRockDenied": {
      "zh": "硬岩挖不动",
      "en": "Bedrock. Can't dig"
    },
    "exitMark": {
      "zh": "出口",
      "en": "Exit"
    }
  },
  "clearGraceRule": "if any cargo remains on board or in a queue when clearGraceSec ends, fail with strings.failClear",
  "rulesV11": {
    "erode": "player-dug lane cells (not presetLanes) collapse to rock after erodeIdleSec with no cargo on them; crack visual erodeWarnSec before; collapse refunds quota; cells with a queued or in-progress action never collapse; a cell's idle timer resets whenever any cargo (narrow or either half of a wide) occupies it, and starts when it is dug; a cell does not count idle while any cargo is in the same column at a higher row (prevents dead-end traps)",
    "wideJitter": "each wide spawn time = atSec + uniform(-wideJitterSec, +wideJitterSec), drawn once per run from a seed; preview starts widePreviewSec before the jittered time; debug panel shows seed and can lock it; the jittered time is snapped to a multiple of wideJitterStepSec (0.5 s) before use",
    "noGrace": "no hidden grace for any cargo; a cargo's 20 s timer runs from birth including queue time (firstWideGraceSec = 0)",
    "tapCancel": "tapping a cell that already has a queued or in-progress action cancels that action (intended)",
    "failOrder": "if failA and failB conditions hit on the same tick, failA wins (unchanged in M1)"
  },
  "mapLegend": {
    "#": "rock",
    "L": "preset lane",
    "H": "hard rock",
    "<": "fork, arrow left",
    ">": "fork, arrow right",
    "E": "exit below this column",
    "x": "no exit below this column",
    "_note": "documentation only; presetLanes/hardRocks/forks/exit.cols are authoritative; last line is the exit row"
  },
  "newFields": {
    "boards": "EXISTING SHAPE, NEW CONTAINER: array of per-board configs; boards[0] is m1-v1.1 unchanged",
    "boards[].id / name": "NEW: board number 1-8 and display name {zh,en}",
    "boards[].grid.rows": "NEW SEMANTICS: rows may differ from cols (board 3 is 6 cols x 7 rows). Code currently uses GRID=cols for both dims",
    "boards[].laneQuota": "per-board quota = preset lane cells (forks excluded) + one full column (grid.rows); producer-approved. Board 1 = 18 unchanged",
    "boards[].hardRocks": "NEW: [row,col] list. Hard rock = rock that cannot be dug; tap gives deniedDig shake + strings.hardRockDenied; never a lane, never counts toward quota, never erodes; for cargo movement identical to rock",
    "boards[].exit.cols": "EXISTING FIELD, NEW SEMANTICS (code ignores it today): only these columns exit. Narrow on the last row exits only if its column is in exit.cols; otherwise 'below' counts as blocked and it uses the normal M1 sidestep rule (a neighbor lane counts as having 'lane below' iff that neighbor's column is in exit.cols). Wide exits only if both of its columns are in exit.cols; otherwise it waits (will time out)",
    "boards[].forks": "SAME FORMAT AS bcf91cf M1Config.forks (ForkSpec): [{r, c, dir:'left'|'right'}]. Fork cells are lanes but NOT listed in presetLanes, not counted in quota, never erode, cannot be filled; tap flips. Checked against bcf91cf src/sim/types.ts, simulation.ts and data/fork-debug.json",
    "boards[].map / intent / expectedPlay / simStatus / copiedFrom": "DOC ONLY, loader may ignore",
    "strings.hardRockDenied / exitMark": "NEW strings",
    "sources.C (board 7)": "NEW, not in code: third gate. At most two gates ship at once, enforced by the wave table (wave1 A, wave2 A+C, wave3 C+B). Needs SourceId 'C', a third queue + queue pips, fail A strings with {gate}=C",
    "hardRocks + column swipe": "per programmer: a column swipe stops at a hard rock; the hard rock and cells below it are not queued",
    "boards[].failBRoute": "DOC ONLY: scripted wrong-fork route that must end in fail B first (boards 4, 6, 8)"
  },
